# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Generated artifacts — do not commit
spreadsheets/*.csv
media/audio/*
media/audio_compressed/*
media/images/*
media/images_compressed/*

# Keep the directories themselves
!spreadsheets/.gitkeep
!media/audio/.gitkeep
!media/images/.gitkeep

# Output — commit all compiled decks except tuttobene
!output/
!output/*.apkg
output/tuttobene*

# Tuttobene — exclude any file or directory with this name elsewhere
*tuttobene*

# Exclude transferable as its a week deck
*Z8_transferable*

# API keys — never commit secrets
.openai
.openrouter
.elevenlabs
.env
*.key

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Kilo AI config
.kilo/
